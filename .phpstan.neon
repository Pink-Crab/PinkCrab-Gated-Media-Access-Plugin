includes:
    - vendor/pink-crab/qa-configs/quality-assurance/phpstan.dist.neon

parameters:
    # johnbillion/wp-compat reads `Requires at least` to date-check hooks. Left
    # to itself it looks for <cwd>/<basename of cwd>.php, which only resolves
    # when the checkout directory happens to share the plugin's name — it does
    # locally, but not in a runner worktree. Name the file instead.
    WPCompat:
        pluginFile: %currentWorkingDirectory%/gated-media-access.php

    bootstrapFiles:
        - type-defs.php
    scanFiles:
        # restrict-media-file-access is a hard runtime dependency but installs
        # as its own plugin, so its symbols are outside our autoload.
        - vendor/pinkcrab/restrict-media-file-access_stubs/restrict-media-file-access_stubs.php
    # House convention: static analysis covers shipped code only — tests are
    # exercised by phpunit, not phpstan.
    paths:
        - src
        - gated-media-access.php
    excludePaths:
        - vendor
        - node_modules (?)
        - wordpress (?)
        - build (?)
        - dist (?)
        - _temp (?)
