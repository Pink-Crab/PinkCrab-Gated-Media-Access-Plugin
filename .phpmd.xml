<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://phpmd.org/xml/ruleset_xml_schema_1.0.0.xsd">
	<description>PHP Mess Detector ruleset for Gated Media Access.</description>

	<!-- Extend the shared Pink-Crab qa-configs ruleset. -->
	<rule ref="./vendor/pink-crab/qa-configs/quality-assurance/phpmd.dist.xml">
		<!--
			WordPress route handlers must halt.

			`wp_safe_redirect()` that does not exit carries on and emits a body
			alongside the Location header; a template takeover that returns
			lets the theme append its own document to ours. Both are bugs, so
			the exits are required rather than tolerated.

			Excluded here rather than with @SuppressWarnings on each method,
			because PHPStan rejects that tag's value and the two tools then
			cannot both pass.
		-->
		<exclude name="ExitExpression"/>
	</rule>

	<!-- Paths excluded from scanning. -->
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/wordpress/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/_temp/*</exclude-pattern>
	<!-- Dev artifact for phpstan only, never loaded at runtime. -->
	<exclude-pattern>*/type-defs.php</exclude-pattern>
</ruleset>
