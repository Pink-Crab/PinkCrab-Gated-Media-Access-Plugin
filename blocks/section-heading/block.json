{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gated-media-access/section-heading",
	"version": "0.1.0",
	"title": "Section heading",
	"category": "widgets",
	"icon": "heading",
	"description": "ui-spec.md §6.9. Uppercase 12px, tracked. A label, not a title.",
	"textdomain": "gated-media-access",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"level": {
			"type": "integer",
			"default": 2
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"interactivity": {
			"clientNavigation": false
		}
	},
	"editorScript": "file:./index.js",
	"style": "gatedmedia-front",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"text": "Available downloads"
		}
	}
}
