{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gated-media-access/action-bar",
	"version": "0.1.0",
	"title": "Pinned action bar",
	"category": "widgets",
	"icon": "align-full-width",
	"description": "ui-spec.md §6.15. Narrow only, Product only. The one pinned element in the design.",
	"textdomain": "gated-media-access",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"href": {
			"type": "string",
			"default": ""
		},
		"form": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"interactivity": {
			"clientNavigation": false
		}
	},
	"editorScript": "file:./index.js",
	"style": "gatedmedia-front",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"label": "Get access — £49.00"
		}
	}
}
