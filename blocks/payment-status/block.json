{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gated-media-access/payment-status",
	"version": "0.1.0",
	"title": "Payment status",
	"category": "widgets",
	"icon": "clock",
	"description": "Where a buyer lands back from Stripe: confirming, done, or failed.",
	"textdomain": "gated-media-access",
	"attributes": {
		"status": {
			"type": "string",
			"default": "pending",
			"enum": [
				"pending",
				"complete",
				"refunded",
				"failed"
			]
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"message": {
			"type": "string",
			"default": ""
		},
		"reference": {
			"type": "string",
			"default": ""
		},
		"uuid": {
			"type": "string",
			"default": ""
		},
		"actionLabel": {
			"type": "string",
			"default": ""
		},
		"actionHref": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false,
		"interactivity": {
			"clientNavigation": false
		}
	},
	"editorScript": "file:./index.js",
	"style": "gatedmedia-front",
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"status": "complete"
		}
	}
}
