<?xml version="1.0"?>
<ruleset name="Gated Media Access" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>Coding standard ruleset for Gated Media Access.</description>

	<!-- Paths excluded from scanning. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/wordpress/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<!-- Working files: design docs plus two third-party reference clones. -->
	<exclude-pattern>/_temp/*</exclude-pattern>
	<!-- Dev artifact for phpstan only, never loaded at runtime. -->
	<exclude-pattern>/type-defs.php</exclude-pattern>

	<!-- Extend the Pink-Crab qa-configs ruleset. -->
	<rule ref="./vendor/pink-crab/qa-configs/quality-assurance/phpcs.dist.xml"/>

	<!-- Pin the text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gated-media-access"/>
			</property>
		</properties>
	</rule>

	<!-- Pin the global prefixes (functions, constants, namespace). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gatedmedia_"/>
				<element value="GATEDMEDIA_"/>
				<element value="PinkCrab\Gated_Access"/>
			</property>
		</properties>
	</rule>
</ruleset>
