# Composer.
/vendor/

# Node.
/node_modules/

# Test artifacts.
/wordpress/
/clover.xml
/coverage-report/
/.phpunit.result.cache
/tests/.env

# Working files — design docs and third-party reference clones.
/_temp/

# Asset build output, via wp-scripts. Never committed.
# blocks/ → build/blocks, assets/js → build/js, assets/scss → build/css.
/build/

# Playwright output — reports, traces and failure screenshots.
/test-results/
/playwright-report/
/blob-report/

# OS.
.DS_Store
Thumbs.db

# Editor / IDE.
.idea/
.vscode/*
!.vscode/settings.shared.json
.claude/
*.swp
*.swo

# Logs.
*.log

# Build output (composer build → dist/, with temp `_build.XXXXXX` work dirs).
/dist/
/_build.*/
